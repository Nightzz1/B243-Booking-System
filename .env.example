# PostgreSQL（请在部署前更换为长随机密码）
POSTGRES_DB=drum_room
POSTGRES_USER=drum_room
POSTGRES_PASSWORD=change-this-before-deploying
POSTGRES_PORT=5432

# 应用数据库连接池
DB_POOL_MAX=10

# 本机容器测试使用 :80；Linux 公网部署时改成域名，例如 booking.example.com
SITE_ADDRESS=:80

# 使用云数据库时，也可以改用以下变量并按供应商要求开启 SSL：
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
