# PostgreSQL（请在部署前更换为长随机密码）
POSTGRES_DB=drum_room
POSTGRES_USER=drum_room
POSTGRES_PASSWORD=change-this-before-deploying
POSTGRES_PORT=5432

# 应用数据库连接池
DB_POOL_MAX=10

# 唯一系统管理员账号（首次登录时自动创建；密码至少 8 个字符）
# 生产环境务必使用独立的长随机密码，不要沿用这里的示例
SYSTEM_ADMIN_ACCOUNT=system-admin
SYSTEM_ADMIN_PASSWORD=replace-with-a-long-random-password
SYSTEM_ADMIN_NAME=系统管理员
SYSTEM_ADMIN_CONTACT=系统维护

# 仅当站点全程使用 HTTPS 时设置为 true；留空时会按请求协议自动判断
SESSION_COOKIE_SECURE=

# 会话：连续闲置 7 天失效，持续使用最多 30 天；剩余不足 24 小时时续期
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_RENEW_BEFORE_HOURS=24

# Next.js 开发服务器允许访问开发资源的主机名/IP（逗号分隔，不含协议和端口）
# 手机通过局域网调试时，请把示例 IP 替换为开发电脑当前的局域网 IP
NEXT_ALLOWED_DEV_ORIGINS=127.0.0.1,192.168.1.100

# 本机容器测试使用 :80；Linux 公网部署时改成域名，例如 booking.example.com
SITE_ADDRESS=:80

# 使用云数据库时，也可以改用以下变量并按供应商要求开启 SSL：
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
